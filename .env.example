# Postgres — la MISMA base que administra AppPack.
# El catálogo, el stock y los pedidos viven acá; no hay copia sincronizada.
DATABASE_URL="postgresql://usuario:clave@host/neondb?sslmode=verify-full"

# Contraseña del panel de solo lectura de la tienda.
ADMIN_PASSWORD="cambiar-esta-contrasena"

# ── Aviso instantáneo desde AppPack (opcional) ──
# Cuando AppPack cambia un precio o un stock, avisa por /api/revalidate y la
# tienda rehace sus páginas al instante en vez de esperar hasta 60 segundos.
# Tiene que ser el MISMO valor que REVALIDATE_SECRET en AppPack.
# Sin esta variable el endpoint responde 501 y no pasa nada más.
# REVALIDATE_SECRET=

# Dónde vive AppPack, si algún día cambia el dominio.
# NEXT_PUBLIC_APPPACK_URL="https://apppack.vercel.app"

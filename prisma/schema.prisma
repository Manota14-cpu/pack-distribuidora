generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  icon        String
  description String
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  description     String
  longDescription String
  /// JSON array of strings
  features        String         @default("[]")
  price           Int
  oldPrice        Int?
  discount        Int?
  sku             String?
  barcode         String?
  weightGrams     Int?
  /// Free text, e.g. "30x20x10 cm"
  dimensions      String?
  stockAvailable  Int            @default(0)
  /// EN DESUSO. Cuando el pedido no descontaba stock, acá se anotaban las
  /// unidades "reservadas" — y no las leía nadie. Ahora la venta descuenta
  /// `stockAvailable` de verdad, así que reservar además contaría doble.
  /// Queda en cero; no escribir sobre esta columna.
  stockReserved   Int            @default(0)
  unit            String
  featured        Boolean        @default(false)
  bestSeller      Boolean        @default(false)
  isNew           Boolean        @default(false)
  rating          Float          @default(0)
  minWholesaleQty Int?
  wholesalePrice  Int?
  metaTitle       String?
  metaDescription String?
  active          Boolean        @default(true)
  /// Lucide icon name used as visual fallback
  icon            String         @default("Package")
  images          ProductImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// Campos operativos que administra AppPack. La tienda no los muestra.
  /// Precio de costo, para calcular el valor del inventario.
  costPrice       Int?
  /// Punto de reposición: por debajo de esto, AppPack avisa.
  minStock        Int            @default(0)
  movements       StockMovement[]
  priceChanges    PriceChange[]
  countItems      StockCountItem[]

  @@index([active, stockAvailable])
}

/// Historial de cada cambio de stock. Lo escribe AppPack a través de la
/// función ajustar_stock(), que además actualiza Product.stockAvailable en
/// la misma transacción — el stock nunca cambia sin dejar rastro.
model StockMovement {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// entrada | salida | creacion | ajuste | venta
  type           String
  quantity       Int
  resultingStock Int
  reason         String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Cada cambio de precio de venta o de costo. El stock ya tenia historial;
/// el precio no, y con inflacion la pregunta "cuanto costaba esto en marzo?"
/// no tenia respuesta.
model PriceChange {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Precio de venta antes y despues. Iguales si solo cambio el costo.
  oldPrice     Int
  newPrice     Int
  /// Precio de costo antes y despues. Null cuando no estaba cargado.
  oldCostPrice Int?
  newCostPrice Int?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Un recuento fisico de inventario: se abre, se van anotando las cantidades
/// contadas y al cerrarlo se generan todos los ajustes de una sola vez.
model StockCount {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  number    Int              @unique
  /// abierto | cerrado | anulado
  status    String           @default("abierto")
  note      String?
  items     StockCountItem[]
  createdAt DateTime         @default(now())
  closedAt  DateTime?

  @@index([status])
}

model StockCountItem {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  countId   String
  count     StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Lo que decia el sistema cuando se anoto el conteo.
  expected  Int
  /// Lo que se conto de verdad. Null mientras no se haya contado.
  counted   Int?

  @@unique([countId, productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Registro de los avisos que AppPack manda solo (reposición, pedidos sin
/// atender). Sirve para dos cosas: dejar constancia de qué se avisó y cuándo,
/// y no repetir el mismo aviso todos los días — se guarda una huella del
/// contenido y solo se vuelve a mandar si cambió o si pasó una semana.
model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  /// Por ahora solo "reposicion".
  type      String
  /// Huella del contenido del aviso.
  digest    String
  /// Canales a los que se envió, separados por coma.
  channels  String
  ok        Boolean  @default(true)
  detail    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  asunto    String?
  mensaje   String?
  createdAt DateTime @default(now())

  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique
  channel        String
  status         String      @default("pendiente")
  tipoCliente    String?
  nombre         String
  razonSocial    String?
  dniCuit        String?
  requiereFactura Boolean   @default(false)
  telefono       String
  email          String?
  direccion      String
  localidad      String
  provincia      String
  notas          String?
  total          Int
  items          OrderItem[]
  createdAt      DateTime    @default(now())

  @@index([channel])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  unit      String
  price     Int
  quantity  Int
}
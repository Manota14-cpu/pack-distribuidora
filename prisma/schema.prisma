generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  icon        String
  description String
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  description     String
  longDescription String
  /// JSON array of strings
  features        String         @default("[]")
  price           Int
  oldPrice        Int?
  discount        Int?
  sku             String?
  barcode         String?
  weightGrams     Int?
  /// Free text, e.g. "30x20x10 cm"
  dimensions      String?
  stockAvailable  Int            @default(0)
  /// EN DESUSO. Cuando el pedido no descontaba stock, acá se anotaban las
  /// unidades "reservadas" — y no las leía nadie. Ahora la venta descuenta
  /// `stockAvailable` de verdad, así que reservar además contaría doble.
  /// Queda en cero; no escribir sobre esta columna.
  stockReserved   Int            @default(0)
  unit            String
  featured        Boolean        @default(false)
  bestSeller      Boolean        @default(false)
  isNew           Boolean        @default(false)
  rating          Float          @default(0)
  minWholesaleQty Int?
  wholesalePrice  Int?
  metaTitle       String?
  metaDescription String?
  active          Boolean        @default(true)
  /// Lucide icon name used as visual fallback
  icon            String         @default("Package")
  images          ProductImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// Campos operativos que administra AppPack. La tienda no los muestra.
  /// Precio de costo, para calcular el valor del inventario.
  costPrice       Int?
  /// Punto de reposición: por debajo de esto, AppPack avisa.
  minStock        Int            @default(0)
  movements       StockMovement[]
  priceChanges    PriceChange[]

  @@index([active, stockAvailable])
}

/// Historial de cada cambio de stock. Lo escribe AppPack a través de la
/// función ajustar_stock(), que además actualiza Product.stockAvailable en
/// la misma transacción — el stock nunca cambia sin dejar rastro.
model StockMovement {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// entrada | salida | creacion | ajuste | venta
  type           String
  quantity       Int
  resultingStock Int
  reason         String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Cada cambio de precio de venta o de costo. El stock ya tenia historial;
/// el precio no, y con inflacion la pregunta "cuanto costaba esto en marzo?"
/// no tenia respuesta.
model PriceChange {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Precio de venta antes y despues. Iguales si solo cambio el costo.
  oldPrice     Int
  newPrice     Int
  /// Precio de costo antes y despues. Null cuando no estaba cargado.
  oldCostPrice Int?
  newCostPrice Int?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Registro de los avisos que AppPack manda solo (reposición, pedidos sin
/// atender). Sirve para dos cosas: dejar constancia de qué se avisó y cuándo,
/// y no repetir el mismo aviso todos los días — se guarda una huella del
/// contenido y solo se vuelve a mandar si cambió o si pasó una semana.
model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  /// Por ahora solo "reposicion".
  type      String
  /// Huella del contenido del aviso.
  digest    String
  /// Canales a los que se envió, separados por coma.
  channels  String
  ok        Boolean  @default(true)
  detail    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  asunto    String?
  mensaje   String?
  createdAt DateTime @default(now())

  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique
  channel        String
  status         String      @default("pendiente")
  tipoCliente    String?
  nombre         String
  razonSocial    String?
  dniCuit        String?
  requiereFactura Boolean   @default(false)
  telefono       String?
  email          String?
  direccion      String?
  localidad      String?
  provincia      String?
  /// Etiqueta rápida del medio de pago: el único usado, o "mixto" si hubo
  /// varios. La verdad está en `payments`; esta columna existe para poder
  /// listar y filtrar sin unir tablas en cada consulta.
  paymentMethod  String?
  payments       OrderPayment[]
  /// Cuánto entregó el cliente en efectivo, para poder reimprimir el vuelto.
  /// No es parte de la venta: es lo que pasó de mano.
  cashReceived   Int?
  /// Turno de caja en el que se cobró, si fue por mostrador.
  sessionId      String?
  session        CashSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  notas          String?
  total          Int
  items          OrderItem[]
  createdAt      DateTime    @default(now())

  @@index([channel])
  @@index([status])
  @@index([sessionId])
}

/// Un turno de caja: se abre con un fondo, se cobra durante el día y se
/// cierra contando lo que hay. La diferencia entre lo esperado y lo contado es
/// el dato que importa — sin turno cerrado no hay contra qué comparar.
model CashSession {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  number       Int       @unique
  /// abierta | cerrada
  status       String    @default("abierta")
  /// Con cuánto efectivo arrancó el turno.
  openingFloat Int       @default(0)
  /// Lo que se contó de verdad al cerrar. Null mientras siga abierta.
  countedCash  Int?
  note         String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  orders       Order[]
  movements    CashMovement[]

  @@index([status])
}

/// Plata que entra o sale de la caja sin ser una venta: se paga un flete, se
/// lleva la recaudación al banco, se agrega cambio. Sin registrarlo, el arqueo
/// de cierre marcaría un faltante que en realidad no lo es — y al tercer día
/// nadie mira más la diferencia.
model CashMovement {
  id        String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId String
  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// retiro | ingreso
  type      String
  /// Siempre positivo; el signo lo da `type`.
  amount    Int
  reason    String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  unit      String
  price     Int
  /// Negativa en una devolución: así toda suma de `price * quantity` da el
  /// signo correcto sin que cada consulta tenga que acordarse del caso.
  quantity  Int
}

/// Cómo se pagó una venta. Una fila por medio de pago, porque en el mostrador
/// "mitad efectivo, mitad transferencia" es lo normal y con una sola columna
/// había que elegir cuál mentir.
model OrderPayment {
  id      String @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// efectivo | transferencia | tarjeta | otro
  method  String
  /// Negativo en una devolución.
  amount  Int

  @@index([orderId])
}
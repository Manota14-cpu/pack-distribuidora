generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// La web solo guarda lo que llega por sus formularios: mensajes de contacto y
// suscripciones al newsletter. Productos, stock, pedidos y cobros están en
// Visual App.

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  asunto    String?
  mensaje   String?
  createdAt DateTime @default(now())

  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}
